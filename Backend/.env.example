PORT=5000
NODE_ENV=production

# MongoDB Atlas (or other hosted MongoDB)
# Use quotes when the URI contains & (required on Windows)
MONGO_URI="mongodb+srv://USER:PASS@cluster.mongodb.net/queue-management?retryWrites=true&w=majority"

# Optional: if you see "querySrv ECONNREFUSED" on Windows, public DNS is used by default in db.js.
# Override with comma-separated servers, or set to empty to use system DNS only.
# DNS_SERVERS=8.8.8.8,8.8.4.4,1.1.1.1

JWT_SECRET=replace-with-a-long-random-secret

# Paste your Render ML service URL (no trailing slash)
ML_SERVICE_URL=https://YOUR-ML-SERVICE.onrender.com

# Paste your Vercel frontend URL (no trailing slash). Comma-separate multiple origins if needed.
CLIENT_ORIGIN=https://YOUR-APP.vercel.app
